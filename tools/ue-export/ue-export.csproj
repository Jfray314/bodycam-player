<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ue_export</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202610" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202610" />
  </ItemGroup>

  <ItemGroup><None Include="guns.json" CopyToOutputDirectory="PreserveNewest" /><None Include="native/CUE4Parse-Natives.dll" Link="CUE4Parse-Natives.dll" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
